{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ssg.sorane.dev/profile/sorane-okf/0.1",
  "title": "sorane-okf/0.1",
  "description": "sorane profile on Open Knowledge Format (OKF) v0.3 base. Required OKF field: type. Profile adds title for article. Optional OKF v0.3 trust/provenance/lifecycle fields accepted.",
  "oneOf": [
    { "$ref": "#/$defs/article" },
    { "$ref": "#/$defs/index" }
  ],
  "$defs": {
    "okfTimestamp": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "string", "format": "date" }
      ],
      "description": "RFC 3339 date-time with explicit UTC offset or full-date (YYYY-MM-DD, start of day in UTC)"
    },
    "actorEvent": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string", "minLength": 1, "description": "Actor: producer/version | human:<id> | team:<id> | process:<id>" },
        "at": { "$ref": "#/$defs/okfTimestamp" }
      },
      "additionalProperties": true
    },
    "dateRange": {
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/okfTimestamp" },
        "to": { "$ref": "#/$defs/okfTimestamp" }
      },
      "additionalProperties": true
    },
    "sourceEntry": {
      "type": "object",
      "required": ["resource"],
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "usage_count": { "type": "number" },
        "last_modified": { "$ref": "#/$defs/okfTimestamp" },
        "usage_window": { "$ref": "#/$defs/dateRange" }
      },
      "additionalProperties": true
    },
    "okfBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "resource": { "type": "string" },
        "tags": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Content-change timestamp; takes precedence over generated.at when both are present"
        },
        "profile": { "type": "string" },
        "generated": { "$ref": "#/$defs/actorEvent" },
        "verified": {
          "oneOf": [
            { "$ref": "#/$defs/actorEvent" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/actorEvent" }
            }
          ]
        },
        "sources": {
          "oneOf": [
            { "$ref": "#/$defs/sourceEntry" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/sourceEntry" }
            }
          ]
        },
        "usage_window": { "$ref": "#/$defs/dateRange" },
        "status": {
          "type": "string",
          "minLength": 1,
          "description": "Lifecycle status: draft | stable | deprecated (unknown values preserved as non-stable per OKF v0.3)"
        },
        "superseded_by": {
          "type": "string",
          "minLength": 1,
          "description": "Path or URI to replacement concept when status is deprecated (OKF v0.3)"
        },
        "stale_after": {
          "$ref": "#/$defs/okfTimestamp",
          "description": "Absolute instant (or UTC start-of-day date); stale when now >= stale_after"
        }
      },
      "additionalProperties": true
    },
    "article": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": {
            "type": { "const": "article" }
          },
          "required": ["type", "title"]
        }
      ]
    },
    "index": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": {
            "type": { "const": "index" }
          },
          "required": ["type", "title"]
        }
      ]
    }
  }
}
